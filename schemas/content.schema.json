{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "macbook-playground/content.schema.json",
  "title": "data/content.json",
  "description": "One teaching card per registry key (src/parts/registry.js KEYS). build.mjs checks the key set and level_min against the registry; this schema checks each card's shape.",
  "type": "object",
  "propertyNames": { "pattern": "^[A-Za-z0-9]+(\\.[A-Za-z0-9]+)*$" },
  "additionalProperties": { "$ref": "#/definitions/card" },
  "definitions": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "why", "connects", "aha", "level_min", "sources"],
      "properties": {
        "what": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "connects": { "type": "string", "minLength": 1 },
        "aha": { "type": "string", "minLength": 1 },
        "level_min": { "type": "integer", "minimum": 1, "maximum": 3 },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
